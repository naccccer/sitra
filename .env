# Frontend dev proxy target (without /api at the end).
VITE_DEV_API_TARGET=http://127.0.0.1
VITE_API_TIMEOUT_MS=10000
# App base path for BrowserRouter/Vite build. Use / for root or /glass-design/ for subpath.
VITE_APP_BASE=/

# Backend database (read by PHP from .env/.env.local or env/env.local).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=glass_design
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_CONNECT_TIMEOUT=5

# Optional API/runtime flags.
APP_DEBUG=1
APP_OWNER_UID=1
# APP_ENV=production
# CORS_ALLOWED_ORIGINS=https://glassdesigno.ir,https://www.glassdesigno.ir
